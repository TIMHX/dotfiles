# ~/.claude holds credentials, session transcripts and shell snapshots.
# This repo is public, so ignore the whole tree and opt in by allowlist.
.claude/**
!.claude
!.claude/CLAUDE.md
!.claude/skills
!.claude/skills/**
!.claude/statusline
!.claude/statusline/**
{{- if eq .chezmoi.os "windows" }}
# Windows 版 statusline 单独一份，只在 Windows 上放行；其它系统仍被 .claude/** 忽略
!.claude/statusline-windows
!.claude/statusline-windows/**
{{- end }}

# settings.json is deliberately NOT allowlisted: cc-switch writes plaintext
# provider API keys into its env block on every switch, and this repo is public.
# Its durable keys are restored by cc-switch's Common Config instead — a sanitised
# export lives at docs/cc-switch-common-config.json.

# 仓库自身的文档，不是要部署到 ~ 的配置
README.md
docs/

# nvim 目录本身是 LazyVim starter 的 git clone；它的 .git 属于那个仓库，不归 dotfiles 管
.config/nvim/.git
.config/nvim/.git/**

{{- if eq .chezmoi.hostname "racknerd-c3b1d83" }}
# VPS：桌面专用的东西不部署；.bashrc 在 VPS 独立维护（默认 shell 是 zsh）
.bashrc
.config/Code
.config/Code/**
bin/cc-layout
{{- end }}
